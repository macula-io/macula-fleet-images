# timescaledb: the postgres frankfurt (macula.io) runs for the realm, the portal and hanko.
#
# This exists so frankfurt runs a postgres image our CI built and signed, because upstream's is
# not signed by our CI and the fleet's reconciler refuses (enforce) or reports (audit) such an image.
#
# WHAT THIS IS, AND IS NOT: a thin rebuild. It starts FROM upstream's image, pinned by its
# multi-arch INDEX digest, and adds only labels and a version check. It does NOT rebuild
# PostgreSQL or TimescaleDB from source: the signature says "our CI took exactly this upstream
# digest", not "we audited its contents". The base.* labels record that digest.
#
# Pinned: TimescaleDB 2.29.2 on PostgreSQL 16, the digest frankfurt has run (macula-fleet
# vps/macula-io/docker-compose.yml). Entrypoint, cmd, volumes and user are upstream's, unchanged.
FROM docker.io/timescale/timescaledb:2.30.2-pg16@sha256:6f139d56042989bd35f50ba5986e492cd32e35cc6778c50be2659add298dc09f

ARG REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/macula-io/macula-fleet-images" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="docker.io/timescale/timescaledb:2.29.2-pg16" \
      org.opencontainers.image.base.digest="sha256:289d55704b1b3ee8263cd3805c6930f9cd54506835a8f19f9b85dad17d5c5a8a"

# Refuse to produce an image that is not what it says: PostgreSQL 16 with the TimescaleDB 2.29.2
# extension installed.
RUN postgres --version | grep -q ' 16\.' \
 && test -f "$(pg_config --sharedir)/extension/timescaledb--2.29.2.sql"
