# hanko: the passkey/auth server frankfurt (macula.io) runs beside the realm and the portal.
#
# This exists so frankfurt runs a hanko image our CI built and signed, because upstream's is not
# signed by our CI and the fleet's reconciler refuses (enforce) or reports (audit) such an image.
#
# WHAT THIS IS, AND IS NOT: a thin rebuild. It starts FROM upstream's image, pinned by its
# multi-arch INDEX digest, and adds only labels and a version check. It does NOT rebuild hanko
# from source: the signature says "our CI took exactly this upstream digest", not "we audited
# its contents". The base.* labels record that digest so anyone can compare against upstream.
#
# Pinned: hanko v2.6.0, the digest frankfurt has run (macula-fleet vps/macula-io/docker-compose.yml).
# Entrypoint (/hanko), user (65532) and everything else are upstream's, unchanged.

# Upstream is distroless (no shell), so the version check runs in its own stage on a copy of the
# binary, and the final image takes a marker from it: the check cannot be skipped by the build.
FROM ghcr.io/teamhanko/hanko:v3.1.2@sha256:51dd4b4d64106aec46b0850605fe86ea3349e82fac8b2d86b7653219c7ff7da3 AS upstream

FROM docker.io/library/busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e AS check
COPY --from=upstream /hanko /hanko
# Refuse to produce an image that is not what it says: the hanko release baked into the binary.
RUN grep -aq 'v2\.6\.0' /hanko && echo v2.6.0 > /hanko-version

FROM upstream
ARG REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/macula-io/macula-fleet-images" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="ghcr.io/teamhanko/hanko:v2.6.0" \
      org.opencontainers.image.base.digest="sha256:a40936c9aac36cc915d7bc2229580e49375850b84cedb475aed2d3c629eff276"
COPY --from=check /hanko-version /hanko-version
