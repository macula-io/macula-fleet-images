# postgres: the database beam-campus.net's hanko runs (macula-fleet#55).
#
# This exists so that box runs a postgres image our CI built and signed, because upstream's is
# not signed by our CI and the fleet's reconciler refuses (enforce) or reports (audit) such an
# image. Until now the box ran docker.io/library/postgres:16-alpine by tag.
#
# WHAT THIS IS, AND IS NOT: a thin rebuild. It starts FROM upstream's image, pinned by its
# multi-arch INDEX digest, and adds only labels and a version check. It does NOT rebuild
# PostgreSQL from source: the signature says "our CI took exactly this upstream digest", not "we
# audited its contents". The base.* labels record that digest so anyone can compare upstream.
#
# Pinned: PostgreSQL 16.15 on Alpine, the exact digest beam-campus.net has run (macula-fleet
# vps/beam-campus-net/docker-compose.yml). The Alpine base is upstream's, so the hanko data
# directory the box already holds is read by the same binaries that wrote it: no locale, no
# libc and no major-version change, which is the whole reason this is a thin rebuild and not the
# Debian-based timescaledb image. Entrypoint, cmd, volumes and user are upstream's, unchanged.
FROM docker.io/library/postgres:18.6-alpine@sha256:10a5c69a83035ab5239f5620d708520e8b28f5aa1f2b20143e6024532edadfb5

ARG REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/macula-io/macula-fleet-images" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.base.name="docker.io/library/postgres:16.15-alpine" \
      org.opencontainers.image.base.digest="sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab"

# Refuse to produce an image that is not what it says: PostgreSQL 16.15, from ALPINE. The Alpine
# test is not decoration. The box's hanko data directory was initialised by musl's postgres, and a
# Debian build of the same version prints "16.15 (Debian 16.15-1.pgdg...)", which a version grep
# alone would accept -- so a hand bump that pasted a Debian digest under this alpine tag would
# sign and be pinned onto that data directory. This line moves with the pin, as hanko's does.
RUN test -f /etc/alpine-release \
 && postgres --version | grep -qx 'postgres (PostgreSQL) 16\.15'
